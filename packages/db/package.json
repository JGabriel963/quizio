{
	"name": "@quizio/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate:deploy": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"db:start": "docker compose -f ../../docker-compose.yml up -d postgres",
		"db:watch": "docker compose -f ../../docker-compose.yml up postgres",
		"db:stop": "docker compose -f ../../docker-compose.yml stop postgres",
		"db:down": "docker compose -f ../../docker-compose.yml down",
		"test": "vitest run",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@quizio/env": "workspace:*",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.22.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@quizio/config": "workspace:*",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
