# Copy to apps/web/.env. Defaults match docker-compose.yml (`pnpm infra:up`).

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
# Set to false to stop new creator accounts (existing accounts keep signing in).
AUTH_SIGN_UP_ENABLED=true

# Google sign-in (optional; set both or neither). Create an OAuth client of type
# "Web application" in Google Cloud Console → APIs & Services → Credentials, with
# the authorized redirect URI {BETTER_AUTH_URL}/api/auth/callback/google
# (locally: http://localhost:3001/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Header the proxy in front of the app reports the client address in (keys the
# rate limits). Vercel overwrites x-forwarded-for, so the default is right there;
# behind your own proxy (VPS) set the one it controls, e.g. x-real-ip.
# CLIENT_IP_HEADER=x-forwarded-for

DATABASE_URL=postgresql://postgres:password@localhost:5432/quizio

# Object storage (S3 protocol) — local RustFS.
# Cloudflare R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, STORAGE_REGION=auto,
# STORAGE_PUBLIC_URL=<custom domain or r2.dev URL>, STORAGE_FORCE_PATH_STYLE=false
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=quizio
STORAGE_SECRET_ACCESS_KEY=quizio-secret
STORAGE_BUCKET=quizio
STORAGE_PUBLIC_URL=http://localhost:9000/quizio
STORAGE_FORCE_PATH_STYLE=true

# Realtime (Pusher protocol) — local Soketi.
# Pusher cloud: remove the *_HOST/*_PORT vars, set the cluster and *_USE_TLS=true.
PUSHER_APP_ID=quizio
PUSHER_KEY=quizio-key
PUSHER_SECRET=quizio-secret
PUSHER_CLUSTER=mt1
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_USE_TLS=false

VITE_PUSHER_KEY=quizio-key
VITE_PUSHER_CLUSTER=mt1
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=6001
VITE_PUSHER_USE_TLS=false

# Creation assistant (spec 027). Leave AI_PROVIDER unset to turn it off.
# anthropic | openai | google (or `fake` for the E2E tests, never in production)
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_GENERATIONS_PER_DAY=20

# Assignments (spec 029): how far ahead a deadline may be, in days (1 to 365).
# ASSIGNMENT_MAX_DEADLINE_DAYS=28

# Notifications (spec 040): how long read ones keep showing, in days (1 to 365).
# NOTIFICATION_READ_RETENTION_DAYS=90

# AI agents over MCP (spec 044): requests per minute per person (10 to 10000),
# active access keys per person (1 to 100) and days an unused authorization
# lasts (1 to 365). The server answers at {BETTER_AUTH_URL}/mcp.
# AGENT_REQUESTS_PER_MINUTE=120
# AGENT_MAX_ACCESS_KEYS=20
# AGENT_CONNECTION_IDLE_DAYS=90
